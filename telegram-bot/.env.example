# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed to bootstrap the bot, comma-separated.
OWNER_TELEGRAM_IDS=123456789
# Optional image/video URL sent with /start. Use a direct .jpg/.png or .mp4 URL.
START_MEDIA_URL=
# Optional: path for persistent JSON data and WhatsApp session files.
DATA_DIR=./data
